# Database (DATABASE_URL is parsed into Spring datasource props)
DATABASE_URL=postgresql://neondb_owner:npg_gnQtrhOc2Id8@ep-odd-pond-a1p9jyfk-pooler.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
Seed_OnStartup=true

APP_FRONTEND_BASE_URL=your-frontend-url
APP_URL=your-backend-url
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
JWT_SECRET=your-jwt-secret

# Shop / geo
Shop_DefaultRegion=MM
Shop_DefaultRegionPrivate=US
Shop_GpsRegionEnabled=true

# MMQR merchant (MyanmarPay) — replace with your MPU/bank merchant credentials
Shop_Mmqr_Guid=A0000006150001
Shop_Mmqr_MerchantId=HOMEMART001
Shop_Mmqr_MerchantName=Home Mart
Shop_Mmqr_MerchantCity=Yangon
Shop_Mmqr_Mcc=5411

# VNQR / VietQR (NAPAS) — replace with your real bank BIN + account
Shop_Vnqr_BankBin=970422
Shop_Vnqr_AccountNumber=0123456789
Shop_Vnqr_AccountName=HOME MART
Shop_Vnqr_MerchantCity=Hanoi
Shop_Vnqr_Mcc=5411

# Stripe — TEST keys only (pk_test_ / sk_test_). Live keys are refused.
STRIPE_KEY=your-stripe-publishable-test-key
STRIPE_SECRET=your-stripe-secret-test-key
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE_ONLY=true

# Mail from-address (used when Resend/SMTP is configured)
Mail_FromAddress=your-mail-from-address
Mail_FromName="your-mail-from-name"

# Firebase (project id is enough for ID-token verify via JWKS)
FIREBASE_PROJECT_ID=your-firebase-project-id
