# Home Mart backend (Spring Boot) — not Laravel.
# Load locally: set -a && source .env && set +a && mvn spring-boot:run
# Quote any value that contains spaces.

# Server
PORT=5199
SPRING_PROFILES_ACTIVE=local
App_Name="Home Mart"
App_Url=http://localhost:5199
App_FrontendUrl=http://localhost:3000

# Database — prefer DATABASE_URL (Neon-style). JDBC vars are an optional fallback.
DATABASE_URL=postgresql://homemart:password@localhost:5432/homemart?sslmode=prefer
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/homemart
# SPRING_DATASOURCE_USERNAME=homemart
# SPRING_DATASOURCE_PASSWORD=homemart
Seed_OnStartup=true

# JWT (min 32 chars) — also signs auth cookies and email-verify links
JWT_KEY=change-me-to-a-long-random-secret-string-32chars
Jwt_Issuer=homemart
Jwt_Audience=homemart

# CORS (* or comma-separated origins)
Cors_AllowedOrigins=*

# Shop / geo
Shop_DefaultRegion=MM
Shop_DefaultRegionPrivate=US
Shop_GpsRegionEnabled=true

# Stripe (optional)
# STRIPE_KEY=
# STRIPE_SECRET=

# Cloudinary (optional — falls back to local storage/)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Mail — Resend preferred; SMTP is the fallback
Mail_FromAddress=no-reply@homemart.app
Mail_FromName="Home Mart"
# RESEND_API_KEY=
# Mail_Smtp_Host=
# Mail_Smtp_Port=587
# Mail_Smtp_Username=
# Mail_Smtp_Password=

# Firebase — FIREBASE_PROJECT_ID alone is enough for ID-token verify (JWKS).
FIREBASE_PROJECT_ID=
# Optional Admin SDK: one-line service account JSON, or ADC path:
# FIREBASE_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
