# Database (DATABASE_URL is parsed into Spring datasource props)
DATABASE_URL=postgresql://neondb_owner:npg_gnQtrhOc2Id8@ep-odd-pond-a1p9jyfk-pooler.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
Seed_OnStartup=true

APP_FRONTEND_BASE_URL=your-frontend-url
APP_URL=your-backend-url
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
JWT_SECRET=your-jwt-secret

# Shop / geo
Shop_DefaultRegion=MM
Shop_DefaultRegionPrivate=US
Shop_GpsRegionEnabled=true

# Stripe (optional)
STRIPE_KEY=your-stripe-key
STRIPE_SECRET=your-stripe-secret

# Mail from-address (used when Resend/SMTP is configured)
Mail_FromAddress=your-mail-from-address
Mail_FromName="your-mail-from-name"

# Firebase (project id is enough for ID-token verify via JWKS)
FIREBASE_PROJECT_ID=your-firebase-project-id
